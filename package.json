{
  "name": "seiten-suikyou",
  "version": "0.1.0",
  "description": "星天水镜 - 基于 miao-plugin 评分内核的原神角色养成评估器",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "imports": {
    "#miao": "./vendor/miao/components/index.js",
    "#miao.models": "./vendor/miao/models/index.js",
    "#miao.path": "./vendor/miao/tools/path.js"
  },
  "dependencies": {
    "limiter": "^4.1.0",
    "lodash": "^4.18.1"
  },
  "scripts": {
    "sync": "python tools/sync.py",
    "sync:check": "python tools/sync.py --check",
    "sync:miao": "python tools/sync.py miao",
    "sync:i18n": "python tools/sync.py i18n",
    "sync:assets": "python tools/sync.py assets",
    "list:assets": "node --disable-warning=ExperimentalWarning tools/list_assets.ts",
    "check:docs": "python tools/check_docs.py",
    "typecheck": "tsc --noEmit",
    "score": "node --disable-warning=ExperimentalWarning src/cli/score.ts",
    "server": "node --disable-warning=ExperimentalWarning src/server/index.ts",
    "test": "npm run typecheck && node test/smoke.ts && node test/arch.ts && node test/enka.ts && node --disable-warning=ExperimentalWarning test/pipeline.ts && node test/i18n.ts && node --disable-warning=ExperimentalWarning test/server.ts && node --disable-warning=ExperimentalWarning test/cli.ts && node test/regression.ts && node test/damage.ts && node test/verify.ts",
    "smoke": "node test/smoke.ts",
    "arch": "node test/arch.ts",
    "enka": "node test/enka.ts",
    "pipeline": "node --disable-warning=ExperimentalWarning test/pipeline.ts",
    "server:test": "node --disable-warning=ExperimentalWarning test/server.ts",
    "cli:test": "node --disable-warning=ExperimentalWarning test/cli.ts",
    "regression": "node test/regression.ts",
    "damage": "node test/damage.ts",
    "verify": "node test/verify.ts",
    "i18n": "node test/i18n.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
