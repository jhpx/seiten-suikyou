{
  "name": "seiten-suikyou",
  "version": "0.1.0",
  "description": "星天水镜 - 基于 miao-plugin 评分内核的原神角色养成评估器",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "imports": {
    "#miao": "./vendor/miao/components/index.js",
    "#miao.models": "./vendor/miao/models/index.js",
    "#miao.path": "./vendor/miao/tools/path.js"
  },
  "dependencies": {
    "limiter": "^4.1.0",
    "lodash": "^4.18.1"
  },
  "scripts": {
    "sync": "python tools/sync.py",
    "sync:check": "python tools/sync.py --check",
    "sync:miao": "python tools/sync.py miao",
    "sync:i18n": "python tools/sync.py i18n",
    "sync:assets": "python tools/sync.py assets",
    "list:assets": "node --disable-warning=ExperimentalWarning tools/list_assets.mjs",
    "check:docs": "python tools/check_docs.py",
    "score": "node --disable-warning=ExperimentalWarning src/cli/score.js",
    "server": "node --disable-warning=ExperimentalWarning src/server/index.js",
    "test": "node test/smoke.mjs && node test/arch.mjs && node test/enka.mjs && node --disable-warning=ExperimentalWarning test/pipeline.mjs && node test/i18n.mjs && node --disable-warning=ExperimentalWarning test/server.mjs && node --disable-warning=ExperimentalWarning test/cli.mjs && node test/regression.mjs && node test/verify.mjs",
    "smoke": "node test/smoke.mjs",
    "arch": "node test/arch.mjs",
    "enka": "node test/enka.mjs",
    "pipeline": "node --disable-warning=ExperimentalWarning test/pipeline.mjs",
    "server:test": "node --disable-warning=ExperimentalWarning test/server.mjs",
    "cli:test": "node --disable-warning=ExperimentalWarning test/cli.mjs",
    "regression": "node test/regression.mjs",
    "verify": "node test/verify.mjs",
    "i18n": "node test/i18n.mjs"
  }
}
