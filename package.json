{
  "name": "seiten-suikyou",
  "version": "0.1.0",
  "description": "星天水镜 - 基于 miao-plugin 评分内核的原神角色养成评估器",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "imports": {
    "#miao": "./vendor/miao/components/index.js",
    "#miao.models": "./vendor/miao/models/index.js",
    "#miao.path": "./vendor/miao/tools/path.js"
  },
  "dependencies": {
    "lodash": "^4.18.1"
  },
  "scripts": {
    "sync": "python tools/sync_miao.py",
    "score": "node --disable-warning=ExperimentalWarning src/cli/score.js",
    "test": "node test/smoke.mjs && node test/arch.mjs && node test/pipeline.mjs && node test/regression.mjs && node test/verify.mjs",
    "smoke": "node test/smoke.mjs",
    "arch": "node test/arch.mjs",
    "pipeline": "node --disable-warning=ExperimentalWarning test/pipeline.mjs",
    "regression": "node test/regression.mjs",
    "verify": "node test/verify.mjs"
  }
}
